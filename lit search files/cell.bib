@article{ WOS:001186741900001,
Author = {Costa, Andre Ramos and Andrade Nery Leao, Zelinda Margarida and Machado,
   Altair de Jesus and Landim Dominguez, Jose Maria and Merces Pereira,
   Gabriela Santiago and Peso Aguiar, Marlene Campos and de Moraes, Simone
   Souza},
Title = {Benthic foraminifera as bioindicators in an area influenced by a
   submarine outfall, North Coast of Bahia, Brazil},
Journal = {REGIONAL STUDIES IN MARINE SCIENCE},
Year = {2024},
Volume = {71},
Month = {APR},
Abstract = {The objective of the research was to evaluate the ecological status of
   an area adjacent to the Cetrel S.A. submarine outfall, in the North
   Coast of the State of Bahia, Brazil. The physical-chemical database of
   the ocean water (temperature, salinity and pH) and the sediment
   geochemistry (TOC, N and P) were used, as well as the results of
   granulometry analyses and the total fauna of benthic foraminifera,
   sampled at ten points during the two seasonal cycles, dry and rainy,
   carried out in 2010 and 2018, in the study area. The results exhibited
   homogeneity in the sedimentary environment adjacent to the outfall,
   where sediments ranged from poorly to very well sorted, typically
   classified as biogenic gravelly sand, exhibiting low nutrient levels.
   This composition reflects the influence of moderate to high
   hydrodynamics and the relative stability of physicochemical water
   parameters. Of the 96 species of foraminifera identified in this study,
   the most important were Amphistegina gibbosa, Peneroplis carinatus and
   Archaias angulatus, which carry symbionts and are the health
   bioindicators in marine environments, mainly coral reefs. The
   foraminiferal assemblages exhibited a homogeneous spatio-temporal
   distribution both in the quali-quantitative composition, in the
   diversity estimate (H') and the FORAM-index (FI), allowing us to infer
   that the predominant ecological quality status in the area was
   satisfactory. However, high rates of anomalous tests were observed among
   symbiont-bearing taxa throughout the area. Despite this, the stability
   in environmental parameters and the predominance of taxa indicative of
   good quality suggest a duality in the origin of the observed
   deformities. These deformities are likely related to regeneration
   events, caused by fragmentation due to strong local hydrodynamics.
   Nevertheless, the possible effects of anthropogenic pollution from the
   disposal of industrial effluents in the study area are not ruled out,
   especially considering that the highest rates of deformities were
   observed in the sampled points near the outfall diffusers of the
   emissary.},
