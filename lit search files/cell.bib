@article{ WOS:A1997XZ12100011,
Author = {Hottinger, L},
Title = {Shallow benthic foraminiferal assemblages as signals for depth of their
   deposition and their limitations},
Journal = {BULLETIN DE LA SOCIETE GEOLOGIQUE DE FRANCE},
Year = {1997},
Volume = {168},
Number = {4},
Pages = {491-505},
Note = {3rd International Conference on Bone Diagenesis, PARIS, FRANCE, MAR
   04-07, 1996},
Abstract = {The interpretation of depth signals from the geological past has to be
   based on the biological meaning of the biogenous carbonate constituants
   of neritic deposits rather than on their taxonomic identity with, Or
   relative closeness to, recent organisms. Foraminifera are a relatively
   independent and particularly useful biological subsystem to be used for
   palaeobathymetric reconstructions of the neritic realm. The most
   important factor limiting the depth-distribution of the tars at species
   level is light by its direct or indirect impact on symbiosis and food.
   Their distribution in the light gradient may be truncated towards depth
   by dines of nutrient concentration or temperature, and towards the
   sea-surface by water energy, photoinhibition or extreme salinity
   gradients.
   The meaning of the depth signal has to be considered separately in each
   time-slice corresponding to a single unit of evolutionary community
   maturation during Earth History. The depth signals provided by the
   foraminifera are the most detailed in mature communities after the
   evolutionary rise of lamellar-perforate. K-strategist larger
   foraminifera subsequent to the Turonian eutrophication event.},
Publisher = {EDP SCIENCES S A},
