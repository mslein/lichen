
@article{ WOS:000077733600013,
Author = {Iwatsuki, K and Nishidoi, M and Suehiro, K},
Title = {Symbiotic Chlorella enhances the thermal tolerance in
   Paramecium bursaria },
Journal = {COMPARATIVE BIOCHEMISTRY AND PHYSIOLOGY A-MOLECULAR AND INTEGRATIVE
   PHYSIOLOGY},
Year = {1998},
Volume = {121},
Number = {4},
Pages = {405-409},
Month = {DEC},
Abstract = {Symbiotic Chlorella enhanced the tolerance to high temperature in
   Paramecium bursaria. We found that 50\% of Chlorella-free P. bursaria
   died within 85 s of exposure to 41 degrees C in a standard saline
   solution, while the presence of Chlorella almost doubled the survival
   time of P. bursaria (160 s, P < 0.001:). The degree of` tolerance in
   3-(3,4-dichlorophenyl)-1,1-dimethylurea tan inhibitor for
   photosynthesis) treated Chlorella-containing P. bursaria and
   Chlorella-containing organisms kept in the dark for 24 h was as low as
   in Chlorella-free organisms. The degree of tolerance to high temperature
   in Chlorella-free P. bursaria in solutions containing maltose, glucose,
   fructose or O-2, was as high as that of normal Chlorella-containing
   organisms. The degree of thermal tolerance in Chlorella-containing P.
   bursaria was not affected in the presence of these carbohydrates or
   oxygen. (C) 1998 Elsevier Science Inc. All rights reserved.},
