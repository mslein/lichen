@article{ WOS:001578088200005,
Author = {Suarez-Ibarra, Jaime Y. and Vieira, Ingrid and Frozza, Cristiane F. and
   Chaabane, Sonia and Palhano, Pamela L. and Kovar, Vojtech and Chalk,
   Thomas B. and Anjos-Zerfass, Geise S. and de Garidel-Thoron, Thibault
