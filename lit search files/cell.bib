   Conte, Maureen H., Bermuda Inst Ocean Sci, St Georges, Bermuda.
   Conte, Maureen H., Marine Biol Lab, Ctr Ecosyst, Woods Hole, MA 02543 USA.},
DOI = {10.1016/j.epsl.2014.05.053},
