@incollection{ WOS:000268462400005,
Author = {Miwa, Isoji},
Editor = {Fujishima, M},
Title = {Regulation of Circadian Rhythms of Paramecium bursaria by
   Symbiotic Chlorella Species},
Booktitle = {ENDOSYMBIONTS IN PARAMECIUM},
Series = {Microbiology Monographs},
Year = {2009},
Volume = {12},
Pages = {83-110},
Abstract = {Cells of Paramecium bursaria show many kinds of circadian rhythms,
   including mating reactivity and photoaccumulation. The period length and
   the phase of circadian rhythms are regulated by symbiotic Chlorella sp.
   under constant light. Chlorella-free white cells of an arrhythmic mutant
   are rescued from the aberrant mating rhythm by reinfecting them with
   Chlorella sp. isolated from wild-type Chlorella-containing green cells.
   Photosynthetic products of symbiotic Chlorella sp. are also effective
   for rescuing arrhythmic mutant white cells. Green cells show a higher
   tolerance to high-temperature stress and chemicals than white cells. The
   immaturity length of progeny from green cells is shorter than that from
   white cells. The functional symbiosis of Chlorella sp. in R bursaria
   serves as a good model for the biological coevolution.},
