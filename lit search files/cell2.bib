@article{ WOS:A1956WX45500007,
Author = {MARGOLIN, P},
Title = {THE CILIARY ANTIGENS OF STOCK-172, PARAMECIUM-AURELIA, VARIETY-4},
Journal = {JOURNAL OF EXPERIMENTAL ZOOLOGY},
Year = {1956},
Volume = {133},
Number = {2},
Pages = {345-387},
Abstract = {Stock 172, variety 4, Paramecium aurelia in capable of expressing
   phenotypically 12 different alternative anti-genic states. Evidence
   obtained indicated that strong cross-reactions of an antigenic type with
   antisera obtained against other types are due only to the activity of
   the antigen gene governing specificity of the antigenic type in
   question. Effects upon the pattern of antigenic transformations of
   factors such as differential inhibitions of initial serotypes,
   temperature, growth rate and exposure to immobilizing antiserum are
   described. Evidence obtained confirms that an antigenic type may
   transform to more than one other type under one set of conditions and
   that the magnitude of a change in conditions may affect stability of an
   existing type in addition to, or instead of, the new conditions
   themselves. The temperature sequence of antigenic types of stock 172 was
   found susceptible to alteration and therefore different from variety 1,
   P. aurelia. Evidence indicates that reduction in metabolic rate may be
   one way in which exposure to immobilizing antiserum affects stability of
   an antigenic type and direction of transformations. Comparison of
   temperature relations of the antigenic types of several variety 4 stocks
   reveals both similarities and differences among corresponding types from
   different stocks. Effects of environmental factors upon antigenic
   transformation are interpreted on the basis of a competitive system in
   which the final outcome results from responses of all antigenic types in
   the system, potential and expressed.},
