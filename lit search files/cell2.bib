@article{ WOS:A1991GG43500008,
Author = {KALISH, JM},
Title = {C-13 AND O-18 ISOTOPIC DISEQUILIBRIA IN FISH OTOLITHS - METABOLIC AND
   KINETIC EFFECTS},
Journal = {MARINE ECOLOGY PROGRESS SERIES},
Year = {1991},
Volume = {75},
Number = {2-3},
Pages = {191-203},
Month = {SEP},
Abstract = {Distribution of oxygen and carbon stable isotopes in fish otoliths from
   a wide range of species was investigated to determine if the isotopes
   were deposited in equilibrium with ambient seawater and, the potential
   utility of isotope data to studies of fish biology. Comparison of
   delta-O-18 and delta-C-13 data from otoliths with estimates of
   equilibrium aragonite indicate that O-18, but not C-13, was deposited
   near equilibrium and this confirms the utility of otolith oxygen
   isotopes as an indicator of ambient temperature. The departure of
   delta-C-13 from equilibrium was considered in light of several current
   theories on C-13 isotope disequilibrium. There was a strong correlation
   between delta-C-13 and temperature and, concomitantly, a strong
   relationship between delta-O-18 and delta-C-13. Evidence is presented to
   support the importance of metabolic effects in mediating C-13
   disequilibria and a strong relationship between metabolic rate (VO2) and
   delta-C-13 is hypothesized. Fishes with low metabolic rates or those
   living at low temperatures had C-13 deposited near to equilibrium,
   whereas fishes living at higher temperatures showed extreme depletion in
   otolith C-13. Trends were also evident in delta-C-13 values in juveniles
   and adults of a species with the juveniles, presumably with a higher
   metabolic rate, being more depleted in C-13 than the adults. The study
   shows that both oxygen and carbon stable isotopes have great potential
   in studies of fish biology and are worthy of further investigation.},
Publisher = {INTER-RESEARCH},
Address = {NORDBUNTE 23, D-21385 OLDENDORF LUHE, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {UNIV TASMANIA, DEPT ZOOL, HOBART, TAS 7001, AUSTRALIA.},
