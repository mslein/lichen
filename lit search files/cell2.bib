@article{ WOS:001417228500001,
Author = {Hardage, Kyle and Wang, Tzu-Hao and Liu, Hou-Chun and You, Chen-Feng and
   Herrera-Silveira, Jorge A. and Street, Joseph H. and Paytan, Adina},
Title = {δ11B Variability in Ammonia parkinsoniana and
   Implications for Paleo-pH in Coastal Margins},
Journal = {PALEOCEANOGRAPHY AND PALEOCLIMATOLOGY},
Year = {2025},
Volume = {40},
Number = {2},
Month = {FEB 11},
Abstract = {Boron isotopes have been used to reconstruct marine pH but less
   frequently in marginal marine environments (lagoons, coastal shelves),
   where paleo-archives are abundant. The dynamic nature of these systems
   complicates environmental reconstruction, requiring a multi-proxy
   approach to constrain changes in conditions. Celestun Lagoon (Yucatan,
   Mexico), influenced by mixing groundwater and seawater, offers a unique
   setting to explore such systems. We analyzed salinity (87Sr/86Sr, delta
   18O), temperature (delta 18O, Mg/Ca), and respiration (delta 13C,
   weight\% organic C) proxies alongside delta 11B and B/Ca in calcite of
   infaunal foraminifera Ammonia parkinsoniana. Results revealed spatial
   variability in delta 11Bcalcite along the lagoon salinity gradient,
   ranging from 8.06 to 18.53 parts per thousand, with higher delta 11B
   variability near groundwater discharge and seagrass beds. This suggests
   low-pH, high-DIC groundwater and primary production influence the delta
   11B signature. Low concentrations of dissolved {[}B], {[}Mg], and {[}Ca]
   in groundwater shift the dissociation constant pKB{*} and possibly the
   fractionation factor alpha B. Notably, some delta 11Bcalcite values
   (8.06 parts per thousand) were lower than expected (11.0 parts per
   thousand), suggesting complex influences from source delta 11Bwater,
   pKB{*}, or dietary carbon with distinct boron signatures. Despite
   variability, foraminifera delta 11Bcalcite (mean +/- SD = 13.22 +/- 3.41
   parts per thousand, n = 21) aligned with calculated mean delta 11Bborate
   (13.64 +/- 1.55 parts per thousand, n = 19), supporting potential use of
   delta 11B for paleo-pH reconstructions in marginal marine settings.
   However, a large sample size may be required to capture average
   conditions. These findings emphasize the need for more studies to
   constrain boron isotopes in marginal marine environments which are
   critical for interpreting paleo-archives in continental shelves and
   shallow seas.},
