   Ruhr Univ Bochum, Inst Geol Mineral \& Geophys, D-44801 Bochum, Germany.},
DOI = {10.1016/j.margeo.2005.02.012},
ISSN = {0025-3227},
EISSN = {1872-6151},
Keywords = {seawater composition; Mg/Ca ratio; Cretaceous; rudist bivalves; low-Mg
   calcite},
