@article{ WOS:000448814600012,
Author = {Sekiguchi, Masaya and Kameda, Shigetoshi and Kurosawa, Satoshi and
   Yoshida, Megumi and Yoshimura, Kenjiro},
Title = {Thermotaxis in Chlamydomonas is brought about by membrane
   excitation and controlled by redox conditions},
Journal = {SCIENTIFIC REPORTS},
Year = {2018},
Volume = {8},
Month = {OCT 31},
Abstract = {Temperature is physiologically critical for all living organisms, which
   cope with temperature stress using metabolic and behavioral responses.
   In unicellular and some multicellular organisms, thermotaxis is a
   behavioral response to avoid stressful thermal environments and promote
   accumulation in an optimal thermal environment. In this study, we
   examined whether Chlamydomonas reinhardtii, a unicellular green alga,
   demonstrated thermotaxis. We found that between 10 degrees C and 30
   degrees C, Chlamydomonas cells migrated toward lower temperatures
   independent of cultivation temperature. Interestingly, when we applied
   reagents to change intracellular reduction-oxidation (redox) conditions,
   we saw that thermotaxis was enhanced, suppressed, or reversed, depending
   on the redox conditions and cultivation temperature. Thermotaxis was
   almost absent in ppr2 and ppr3 mutants, which cannot swim backward
   because of a defect in generating calcium current in flagella. The
   frequency of spontaneous backward swimming was lower at more favorable
   temperature, suggesting a pivotal role of spontaneous backward swimming
   generated by flagellar membrane excitation.},
Publisher = {NATURE PORTFOLIO},
Address = {HEIDELBERGER PLATZ 3, BERLIN, 14197, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Yoshimura, K (Corresponding Author), Shibaura Inst Technol, Coll Syst Engn \& Sci, Dept Machinery \& Control Syst, Saitama 3378570, Japan.
   Sekiguchi, Masaya; Kameda, Shigetoshi; Kurosawa, Satoshi; Yoshida, Megumi; Yoshimura, Kenjiro, Shibaura Inst Technol, Coll Syst Engn \& Sci, Dept Machinery \& Control Syst, Saitama 3378570, Japan.},
DOI = {10.1038/s41598-018-34487-4},
Article-Number = {16114},
ISSN = {2045-2322},
