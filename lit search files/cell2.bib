@article{ WOS:000200177300002,
Author = {Pace, DM and Kimura, KK},
Title = {The effect of temperature on respiration in Paramecium aurelia and
   Paramecium caudatum},
Journal = {JOURNAL OF CELLULAR AND COMPARATIVE PHYSIOLOGY},
Year = {1944},
Volume = {24},
Number = {3},
Pages = {173-183},
Month = {DEC},
Abstract = {The rates of O2 concs., for P. aurelia at 20{[}degree], 25{[}degree],
   30{[}degree] and 35{[}degree] were approx. 3.52, 6.13, 8.27 and 15.04
   ml''/hr./ml3 cell substance, respectively, and for P. caudatum at
   15{[}degree], 20{[}degree], 25{[}degree], 30{[}degree] and 35{[}degree],
   2.78, 3.30, 6.03, 8.40 and 15.15, respectively. Volumes and surface
   areas were found to be approx. 100,500 u3 and 11,250 u2, respectively,
   for the average P. aurelia and 640,000 u3 and 44,600 u2, respectively,
   for P. caudatum. The results indicate that the rate of O2 consumption in
   Paramecium is a function of cell vol. A Q10 of 2.36 was found between
   20{[}degree] and 30{[}degree]C. and 2.55 between 25{[}degree] and
   35{[}degree]C. for P. aurelia. In P. caudatum Q10 is 2.17 between
   15{[}degree] and 25{[}degree]C, 2.54 between 20{[}degree] and
   30{[}degree]C, and 2.51 between 25{[}degree] and 35{[}degree]C. The R.Q.
   in both spp. varies directly with the temp. and in P. aurelia is 0.73,
   0.80, 0.90, and 0.88 and in P. caudatum, 0.70, 0.65, 0.75, 0.87, and
   0.99 at the temps. given above. Paramecium has a greater carbohydrate
   metabolism at high than at low temps.},
