@article{ WOS:A1976BE00800004,
Author = {MATSUMOTO, T},
Title = {ROLE OF TERMITES IN AN EQUATORIAL RAIN-FOREST ECOSYSTEM OF WEST MALAYSIA
   .1. POPULATION-DENSITY, BIOMASS, CARBON, NITROGEN AND CALORIFIC CONTENT
   AND RESPIRATION RATE},
Journal = {OECOLOGIA},
Year = {1976},
Volume = {22},
Number = {2},
Pages = {153-178},
Abstract = {Four dominant species of epigeous nest builders, Macrotermes
   carbonarius, Dicuspiditermes nemorosus type-a, type-b and Homallotermes
   foraminifer were studied to reveal their role in the ecosystem. The
   density of nests or mounds was 15-41/ha in M. carbonarius, 60-110/ha in
   the 2 types of D. nemorosus and 85-165/ha in H. foraminifer. The
   population number per nest or mound was about 88,000 in M. carbonarius,
   45,000 in D. nemorosus type-a, 47,000 in D. nemorosus type-b and 13,000
   in H. foraminifer. The population number per hectare was about 1.8
   .times. 106 for M. carbonarius, 4.3 .times. 106 for D. nemorosus type-a,
   5.2 .times. 106 for D. nemorosus type-b and 2.1 .times. 106 for H.
   foraminifer. The ratio in number of workers to soldiers was 6.4 for M.
   carbonarius, 19.0 for D. nemorosus type-a, 23.1 for D. nemorosus type-b
   and 8.9 for H. foraminifer. The ratio in number of adults (workers plus
   soldiers) to larvae was 1.4 for M. carbonarius, 0.59 for D. nemorosus
   type-a, 1.76 for D. nemorosus type-b and 3.84 for H. foraminifer. The
   number of adults per nest of D. nemorosus type-a, type-b and H.
   foraminifer was linearly correlated with the weight of nest on log-log
   coordinates. The ratio of dry body weight to live weight was 0.24-0.30
   for workers, 0.19-0.29 for soldiers and 0.15-0.22 for larvae. The ash
   content of termite bodies was 26-66\% for workers, 2-24\% for soldiers
   and 1-4\% for larvae. The C content ranged from 45\%-66\% of ash-free
   dry weight and the N content from 5.6-12.6\%. The mean calorific value
   of termite bodies was 5.3 gcal/mg in workers and soldiers on an ash-free
   weight basis, but was greater in nymphs and winged reproductives in the
   nest (6.7-6.9 gcal/mg) owing probably to their large fat storage. The
   relation of the CO2 evolution rate to temperature in these termites was
   similar to what has been found in other insects. The total biomass of
   the 4 termite species was estimated at 6.01 kg ash-free dry weight/ha,
   equivalent to 0.55 kg N/ha and 3.09 kg C/ha. The role of the fungi
   cultivated by M. carbonarius on their fungus combs is discussed in
   relation to the nutrition of termites and the decomposition of
   leaf-litter with special reference to N metabolism. The high N content
   of fungus spherules growing on fungus combs seemed to have an important
   bearing on the nutrition of termites. The termites played a very
   important role in the organic matter decomposition cycle of Pasoh
   Forest.},
Publisher = {SPRINGER},
Address = {ONE NEW YORK PLAZA, SUITE 4600, NEW YORK, NY, UNITED STATES},
Type = {Article},
Language = {English},
Affiliation = {TOKYO METROPOLITAN UNIV, FAC SCI, DEPT BIOL, 2-1-1 FUKAZAWA, STATGAYA 158, TOKYO, JAPAN.},
DOI = {10.1007/BF00344714},
ISSN = {0029-8549},
EISSN = {1432-1939},
Research-Areas = {Environmental Sciences \& Ecology},
Web-of-Science-Categories  = {Ecology},
Affiliations = {Tokyo Metropolitan University},
