@article{ WOS:A19621441B00012,
Author = {JOHNSON, BF},
Title = {INFLUENCE OF TEMPERATURE ON RESPIRATION AND METABOLIC EFFECTIVENESS OF
   CHILOMONAS},
Journal = {EXPERIMENTAL CELL RESEARCH},
Year = {1962},
Volume = {28},
Number = {2},
Pages = {419+},
Abstract = {Chilomonas paramecium, a colorless cryptomonad flagellate, was grown
   upon defined medium at 15{[}degree], 20{[}degree] and 25{[}degree]C.
   Cultures were permitted to grow to the concentration at which the 02
   consumption was determined. Standard Warburg technics were used. The
   rate of respiration was obtained at 15{[}degree], 20{[}degree] and
   25{[}degree]C for different aliquots of cells from each culture. It was
   shown that while growth temperature had no effect upon the measured
   respiration, there was a Q10 of 2.8 over the temperature range at which
   the respiratory rates were measured. The average QO2/106 cells/hr
   measured at 25{[}degree]C was 29. Since the cells grown at lower
   temperatures were larger, the results also show that there was no effect
   of cellular volume nor of cellular membrane area upon the rate of
   respiration. The failure of growth temperature to influence the measured
   respiratory rates indicated that Chilomonas does not have a respiratory
   adaptation to temperature; this is Type IV in Precht''s terminology. The
   effect of growth temperature upon metabolic effectiveness (amount of
   protoplasmic constituents synthesized per unit 02 consumed) was
   calculated for deoxypentose nucleic acid, pentose nucleic acid, protein
   and dry weight. Lowered temperatures resulted in diminished
   effectiveness ratios. There is probably no intimate association of
   mechanisms of adaptation in respiration and size where both are found in
   the same organism.},
Publisher = {ELSEVIER INC},
Address = {525 B STREET, STE 1900, SAN DIEGO, CA 92101-4495 USA},
