   Natl Ctr Ecol Anal \& Synth, Santa Barbara, CA 93101 USA.
   Univ Florida, Dept Zool, Gainesville, FL 32611 USA.
   Harvard Univ, Bauer Ctr Genom Res, Boston, MA 02138 USA.
   Univ New Mexico, Dept Biol, Albuquerque, NM 87131 USA.},
DOI = {10.1073/pnas.0603587103},
ISSN = {0027-8424},
Keywords = {allopatric speciation; biodiversity; macroevolution; metabolic theory of
   ecology; molecular clock},
Keywords-Plus = {MOLECULAR EVIDENCE; SPECIES-DIVERSITY; BODY-SIZE; LATITUDINAL GRADIENTS;
   CRYPTIC SPECIATION; EVOLUTION; ENERGY; DIVERSIFICATION; GENERATION;
