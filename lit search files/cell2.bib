@article{ WOS:A19635615B00015,
Author = {MURRAY, JW},
Title = {ECOLOGICAL EXPERIMENTS ON FORAMINIFERIDA},
Journal = {JOURNAL OF THE MARINE BIOLOGICAL ASSOCIATION OF THE UNITED KINGDOM},
Year = {1963},
Volume = {43},
Number = {3},
Pages = {621+},
Abstract = {Fifteen experiments on the foraminiferid Elphidium crispum (L.) are
   described; they deal with feeding, movement, the substratum, and
   salinity, and their bearing on ecology. The daily production of feeding
   cysts was used as a measure of the metabolic rate and healthiness of the
   foraminiferids. Phaeodactylum tricornutum, both living and dead, was
   used as food; a distinct preference was shown for living food. However,
   kaolin and graphite having a similar size to the Phaeodactylum were also
   accepted as ``food{''}. It is suggested that E. crispum selects its food
   on the basis of size. The color of the protoplasm is shown to be closely
   related to the pigments of the food. Movement in the horizontal plane is
   normally random. However, this species prefers a clean, hard substratum
   to one of clay; once a specimen has escaped from a clay substratum, it
   is loath to return to it and therefore movement in this instance must be
   directed and not random. The rate of feeding is shown to be closely
   related to the salinity of the water, the feeding rate decreasing with
   the salinity. The amount of calcium present in sea water or in subsaline
   waters does not appear to affect the rate of feeding. However, lowered
   temperatures help E. crispum to survive for longer periods in sub-saline
   water. At temperatures of 8{[}degree] and 16{[}degree]C, cultures
   survived subsaline water of 20\%o salinity for 38 days, but at a
   salinity of 15\%, only the culture kept at 8{[}degree]C survived (for 15
   days). A shortage of food was considered to be the cause of the
   formation of small chambers which produced notches in the outline of the
   tests of juvenile specimens. A general review of the palaeoecological
   import of these results is given together with a brief discussion on
   size.},
