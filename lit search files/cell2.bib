@article{ WOS:A19649744A00046,
Author = {SAMOILOVA, KA},
Title = {SENSITIVITY OF PARAMECIUM CAUDATUM TO INHIBITORS OF RESPIRATION +
   GLYCOLYSIS VARYING ACCORDING TO CULTURE AGE},
Journal = {DOKLADY AKADEMII NAUK SSSR},
Year = {1964},
Volume = {155},
Number = {3},
Pages = {670+},
Abstract = {Clonal cultures of Paramecium caudatum, in the 3 last phases of growth,
   were studied. The infusoria were cultivated on Lozina-Lozinskii mineral
   medium at a temperature of 22{[}degree]. The growth of the culture was
   calculated from the moment of transfer of the infusoria to a fresh
   medium, when 1 cm3 of a 7-day culture was inoculated into 10 cm3 of the
   medium, to which dry baker''s yeast was added. KCN (.002{[}image].) and
   malonate were used as inhibitors. Monoiodoacetate (.00002 {[}image]) was
   used to suppress gly-colysis. The solutions of inhibitors were prepared
   on cultural medium. The pH of the solutions was kept equal to 6.8. The
   malonate was also used at lower pH values. In each experiment, 100
   infusoria of an appropriate age were put in a microaquarium with a
   definite quantity of solution of inhibitor, and then at definite
   periods, a count of the surviving individuals was made. Infusoria in the
   2nd (logarithmic or exponential) phase of growth were most sensitive to
   KCN. They perished after 12 hours of action of the inhibitor. In the 3rd
   stationary phase, only isolated cells perished, and after 2 days they
   were apparently so adapted to the inhibitor, that some of them even
   entered into division, so that the quantity of infusoria at 48 hours
   from the beginning of the experiment exceeded the initial number. With
   increase in age of the culture (beginning with the 15-20th day), the
   resistance of P. caudatum to KCN was appreciably reduced. The reverse
   picture was observed in relation to monoiodoacetate. After 4 hours of
   action of the inhibitor, almost all cells from the stationary phase
   perished, while the ``younger{''} infusoria still proved to be viable
   for whole days. A culture aged 18-25 days was more sensitive. No
   significant differences in cultures of different ages in resistance to
   malonate were established. All this illustrates the high lability of the
   enzymatic systems in this group of monocellular organisms.},
