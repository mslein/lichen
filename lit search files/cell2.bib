DOI = {10.1152/ajpregu.1996.270.1.R169},
ISSN = {0363-6119},
Keywords = {hypoxia; sodium azide; sodium cyanide; anapyrexia; hypothermia;
   temperature regulation; respiration},
Keywords-Plus = {BEHAVIORAL THERMOREGULATION; HYPOTHERMIA; HYPOXIA},
