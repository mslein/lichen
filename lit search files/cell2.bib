   YAMAMOTO, Koshi/0000-0002-7277-4246},
Funding-Acknowledgement = {Japan Society for the Promotion of Science {[}26302008]; Grants-in-Aid
   for Scientific Research {[}17H06105, 17K05685, 26302008] Funding Source:
   KAKEN},
Funding-Text = {We are most grateful to K. Endo for providing specimens of K. hanzawai
   off Amami-o-shima and useful information on K. hanzawai. Special thanks
