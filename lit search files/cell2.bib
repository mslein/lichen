@article{ WOS:A1979GR91200007,
Author = {KAHN, MI},
Title = {NONEQUILIBRIUM OXYGEN AND CARBON ISOTOPIC FRACTIONATION IN TESTS OF
   LIVING PLANKTONIC-FORAMINIFERA},
Journal = {OCEANOLOGICA ACTA},
Year = {1979},
Volume = {2},
Number = {2},
Pages = {195-208},
Abstract = {O2 and C isotopic analyses were performed on 9 spp. of planktonic
   foraminifera {[}Globigerinoides ruber, G. trilobus, Neogloboquadrina
   dutertrei, Globorotalia menardii, G. tumida, Sphaeroidinella dehiscens,
   Pulleniatina obliquiloculata, Globigerinella aequilateralis and Orbulina
   universa] collected from known depth intervals of the eastern equatorial
   Atlantic Ocean. In situ temperature and salinity and local and regional
   stable isotopic, oceanographic and faunal data were used in the
   interpretation of the results. Depletion in both 18O and 13C was found
   in the calcite tests of many species relative to calcite precipitated in
   equilibrium with ambient seawater. Minimum estimates of the departures
   from isotopic equilibrium range from .apprx. 0.permill. in P.
   obliquiloculata to -1.57.permill. in N. dutertrei for .delta. 18O, and
   from -0.69.permill. in N. dutertrei to -3.48.permill. in G.
   aequilateralis for .delta. 13C. Comparison between larger and smaller
   size groups of the same species reveals the existence of ontogenetic
   decreases in the vital effect for either .delta. 18O, .delta. 13C or
   both. The ontogenetic decreases in vital effect may be caused by
   decreases in metabolic rate with age in the utilization of metabolic CO2
   in test secretion. Fair agreement was found between the relative depth
   habitats estimated using plankton tow counts, O2 and C isotopic data of
   the larger size groups and the O2 isotopic ratios of the smaller and
   larger size groups combined. There was no agreement when only
   populations of smaller size groups were considered. The hypothesis that
   planktonic foraminifera kummerform chambers develop due to environmental
   stress was discussed. Bias in paleotemperature determinations may be
   minimized if isotopic analyses are performed on limited size ranges.},
