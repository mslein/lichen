@article{ WOS:000709711800010,
Author = {Kenigsberg, Chen and Titelboim, Danna and Ashckenazi-Polivoda, Sarit and
   Herut, Barak and Kucera, Michal and Zukerman, Yuval and Hyams-Kaphzan,
   Orit and Almogi-Labin, Ahuva and Abramovich, Sigal},
Title = {The combined effects of rising temperature and salinity may halt the
   future proliferation of symbiont-bearing foraminifera as ecosystem
   engineers},
Journal = {SCIENCE OF THE TOTAL ENVIRONMENT},
Year = {2022},
Volume = {806},
Number = {2},
Month = {FEB 1},
Abstract = {Rising sea surface temperatures and extreme heat waves are affecting
   symbiont-bearing tropical calcifiers such as corals and Large Benthic
   Foraminifera (LBF). In many ecosystems, parallel to warming, global
   change unleashes a host of additional changes to the marine environment,
   and the combined effect of such multiple stressors may be far greater
   than those of temperature alone. One such additional stressor,
   positively correlated to temperature in evaporation-dominated
   shallow-water settings is rising salinity. Here we used laboratory
   culture experiments to evaluate the combined thermohaline tolerance of
   one of the most common LBF species and carbonate producer, Amphistegina
   lobifera. The experiments were done under ambient (39 psu) and modified
   (30, 45, 50 psu) salinities and at optimum (25 degrees C) and warm
   temperatures (32 degrees C). Calcification of the A. lobifera holobiont
   was evaluated by measuring alkalinity loss in the culturing seawater, as
   an indication of carbonate ion uptake. The vitality of the symbionts was
   determined by monitoring pigment loss of the holobiont and their
   photosynthetic performances by measuring dissolved oxygen. We further
   evaluated the growth of Peneroplis (P. pertusus and P. planatus), a
   Rhodophyta bearing LBF, which is known to tolerate high temperatures,
   under elevated salinities. The results show that the A. lobifera
   holobiont exhibits optimal performance at 39 psu and 25 degrees C, and
   its growth is significantly reduced upon exposure to 30, 45, 50 psu and
   under all 32 degrees C treatments. Salinity and temperature exhibit a
   significant interaction, with synergic effects observed in most
   treatments. Our results confirm that Peneroplis has a higher tolerance
   to elevated temperature and salinity compared to A. lobifera, implying
   that a further increase of salinity and temperatures may result in a
   regime shift from Amphistegina-to Peneroplis- dominated assemblages. (c)
   2021 Published by Elsevier B.V.},
