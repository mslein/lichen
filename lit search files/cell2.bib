@article{ WOS:000344514500005,
Author = {Hesse, T. and Wolf-Gladrow, D. and Lohmann, G. and Bijma, J. and
   Mackensen, A. and Zeebe, R. E.},
Title = {Modelling δ13C in benthic foraminifera: Insights from model
   sensitivity experiments},
Journal = {MARINE MICROPALEONTOLOGY},
Year = {2014},
Volume = {112},
Pages = {50-61},
Month = {OCT},
Abstract = {The delta C-13 value measured on benthic foraminiferal tests is widely
   used by palaeoceanographers to reconstruct the distribution of past
   water masses. The biogeochemical processes involved in forming the
   benthic foraminiferal delta C-13 signal (delta C-13(foram)), however,
   are not fully understood and a sound mechanistic description is still
   lacking. We use a reaction-diffusion model for calcification developed
   by Wolf-Gladrow et al. (1999) and Zeebe et al. (1999) in order to
   quantify the effects of different physical, chemical, and biological
   processes on delta(13)Cforam of an idealised benthic foraminiferal
   shell. Changes in the delta C-13 value of dissolved inorganic carbon
   (delta C-13(DIC)) cause equal changes in delta C-13(foram) in the model.
   The results further indicate that temperature, respiration rate, and pH
   have a significant impact on delta C-13(foram). In contrast, salinity,
   pressure, the delta C-13 value of particulate organic carbon (delta
   C-13(POC)), total alkalinity, and calcification rate show only a limited
   influence. In sensitivity experiments we assess how combining these
   effects can influence delta C-13(foram). We can potentially explain 33
   to 47\% of the interglacial-to-glacial decrease in delta C-13(foram) by
   changes in temperature and pH, without invoking changes in delta
   C-13(DIC). Furthermore, about a quarter of the 0.4\% change in delta
   C-13(foram) observed in phytodetritus layers can be accounted for by an
   increase in respiration rate and a reduction in pH. (C) 2014 Elsevier
   B.V. All rights reserved.},
