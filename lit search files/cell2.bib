@article{ WOS:001501498200001,
Author = {Palme, Tina and Nagy, Matthias and Heinz, Petra},
Title = {Quantifying rates of oxygen production and consumption in the benthic
   foraminifer Amphistegina lobifera at different temperatures},
Journal = {MARINE BIOLOGY},
Year = {2025},
Volume = {172},
Number = {7},
Month = {JUN 2},
Abstract = {The benthic foraminifer Amphistegina lobifera Larsen 1976 is a major
   carbonate producer and an invasive species in the Mediterranean Sea,
   where its thermal tolerance contributes to its expansion. This study
   investigates A. lobifera's short-term response in respiration rate and
   photosynthetic activity across a temperature range of 16-36 degrees C
   following an acclimation period of 24 h. Oxygen consumption and
   production were recorded using non-invasive oxygen sensor spots,
   allowing for continuous measurements with minimal disturbance to the
   specimens. Results show a significant influence of temperature on
   respiration rates and photosynthetic activity. Oxygen consumption was at
   a minimum at 16 degrees C and increased with temperature, peaking at 32
   degrees C before slightly decreasing at 36 degrees C. Photosynthetic
   rates followed a unimodal response, with peak oxygen production at 24
   degrees C and a sharp decline at 36 degrees C. At this upper threshold
   respiration exceeded photosynthesis, indicating a decoupled response by
   the holobiont and its endosymbionts. As short-term thermal stress
   significantly influenced the holobiont's metabolism, A. lobifera may
   seasonally or diurnally shift from net oxygen producer to net consumer.
   Given its high abundance in coastal benthic environments, this metabolic
   plasticity may affect benthic communities, that already suffer
   increasing thermal stress by globally heating waters. The study
   emphasises the need for further research on short-term thermal responses
   in benthic foraminifera and their role in oxygen cycles under ongoing
   climate change.},
Publisher = {SPRINGER HEIDELBERG},
Address = {TIERGARTENSTRASSE 17, D-69121 HEIDELBERG, GERMANY},
Type = {Article},
Language = {English},
Affiliation = {Palme, T (Corresponding Author), Univ Vienna, Dept Palaeontol, Josef Holaubek Pl 2, A-1090 Vienna, Austria.
