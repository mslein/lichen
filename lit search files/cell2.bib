@article{ WOS:A1996WK89600004,
Author = {Rao, CP},
Title = {Oxygen and carbon isotope composition of skeletons from temperate shelf
   carbonates, Eastern Tasmania, Australia},
Journal = {CARBONATES AND EVAPORITES},
Year = {1996},
Volume = {11},
Number = {2},
Pages = {169-181},
Abstract = {Eastern Tasmanian shelf carbonates contain abundant skeletons of
   bryozoa, foraminifera and bivalve mollusca and minor brachiopods. The
   delta(18)O and delta(13)C isotope fields of Tasmanian bryozoa, benthic
   foraminifera, bivalve mollusca and brachiopods overlap other temperate
   brachiopods from North Atlantic and South Pacific shallow seas. The
   temperate skeleton isotope fields differ from isotope fields of similar
   types of skeletons from tropical shallow seas in having higher
   delta(18)O values. The delta(18)O and delta(13)C isotopes of temperate
   skeletons are least affected by metabolic effects and kinetic
   fractionation, in contrast to strong metabolic and kinetic effects in
   many tropical skeletons.
   The delta(18)O values of skeletons, taking delta w=0 in delta(18)O parts
   per thousand SMOW, give range of temperatures similar to those of
   measured values. The delta(18)O values of Tasmanian benthic foraminifera
   and brachiopods become heavier with increasing water depth due to the
   decrease in water temperature. Temperate carbonates are in equilibrium
   with delta(13)C in seawater and not with that in atmospheric CO2. The
   differences in delta(13)C and delta(18)O values between skeletons in the
   same sample represent variable growth rates of skeletons with
   brachiopods forming at the slowest rate, bryozoans at moderate rate and
   foraminifera at fast rate. The depth and latitudinal variation of
   delta(18)O and delta(13)C values of skeletons are due to differences in
   water temperatures, carbonate mineralogy, the rate of formation of these
   skeletons and mixing of water masses.},
