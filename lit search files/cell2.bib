@article{ WOS:A1976EH99700003,
Author = {SOURNIA, A and RICARD, M},
Title = {DATA ON HYDROLOGY AND PRODUCTIVITY OF A CLOSED LAGOON (TAKAPOTO, TUAMOTU
   ISLANDS)},
Journal = {VIE ET MILIEU SERIE B-OCEANOGRAPHIE},
Year = {1976},
Volume = {26},
Number = {2},
Pages = {243-279},
Abstract = {Takapoto is a landlocked atoll in the Taumotu Islands, French Polynesia;
   exchanges with oceanic water are restricted to the so-called hoas which
   are narrow and very shallow apertures of the atoll rim (there are no
   passes). Residence time of the lagoon water, as roughly estimated from
   salinity differences or water exchange, would be about 4 yr. The average
   depth is 23 m; transparency in the euphotic layer extends to the whole
   body of water. The lagoon was studied extensively during Aug. 1975 (cold
   and dry season) with respect to temperature, salinity, N-NO3 P-PO4,
   Si-SiO4 and chlorophyll; in addition, measurements of phytoplankton cell
   numbers, benthic primary production, planktonic primary production and
   O2 metabolism were obtained at a few stations in the lagoon. The
   hydrological characteristics and chlorophyll content of oceanic water
   were studied at a few stations outside and in the water entering the
   lagoon through the main hoa. The lagoon was homogeneous with respect to
   temperature, salinity and nutrients. Salinity was higher than that of
   the ocean; nutrient concentrations were extremely low and < in the
   oligotrophic ocean. Chlorophyll content was high (0.46 .mu.g 1-1) in the
   lagoon and significantly higher than in the ocean (0.14); furthermore,
   chlorophyll concentrations in the lagoon increased from the northeast to
   the southwest and were vertically stratified at some places.
   Phytoplankton populations were dominated by dinoflagellates. Primary
   production of phytoplankton as measured by 14C in situ uptake varied
   from 20 to 400 mg C m-2 day-1 at 1 m and 20 m stations, respectively.
   Diel changes in dissolved O2 concentration at a 1 m station on the
   southwest side of the lagoon were used to compute total metabolism,
   according to H.T. Odum''s principle. Gross production of the ecosystem
   was 4 g C m-2 day-1. This, with discrete measurements of O2 metabolism
   on the giant clams (Tridacna maxima) and on foraminiferan sands,
   provided evidence of the overwhelming role of benthos over plankton in
   the lagoon. However, net poduction of the ecosystem on a 14 h basis was
   not significant. Takapoto lagoon behaves like a nutrient-depleted water
   lens amid an oligotrophic ocean; yet it sustains an appreciable level of
   phytoplankton life and a fairly opulent benthic life. High turn-over
   rates may explain partly such a situation.},
Publisher = {MASSON EDITEUR},
Address = {21 STREET CAMILLE DESMOULINS, ISSY, 92789 MOULINEAUX CEDEX 9, FRANCE},
Type = {Article},
Language = {French},
Affiliation = {ECOLE PRAT HAUTES ETUDES, TAHITI, French Polynesi, FRANCE.},
Keywords-Plus = {PHYTOPLANKTON; ATOLL; REEF; DETRITUS; WATERS},
