@article{ WOS:000200626900006,
Author = {Emery, FE},
Title = {The metabolism of amino-acids by Paramecium caudatum},
Journal = {JOURNAL OF MORPHOLOGY AND PHYSIOLOGY},
Year = {1928},
Volume = {45},
Number = {2},
Pages = {555-577},
Month = {JUN},
Abstract = {The amino-acids were used in 0.1 \% solution and were tested, by the
   Henriques-Sorensen formol titration at the beginning and after the
   paramecia had lived in these amino-acids for 12 hrs. The difference
   between these 2 tests, figured in percentage, is considered as the
   amount utilized by the paramecia. The part played by bacteria was found
   to be negligible when isolated amino-acids were studied. The influence
   of temperature on the rate of utilization of the amino-acids has been
   studied, and the results show a direct relationship between the 2. The
   rate of utilization was decreased by anesthetics and nitroglycerin. A
   careful study has been made of a number of isolated amino-acids and the
   rate of utilization of each discussed in relationship to the others
   studied. An explanation of why one amino-acid was used more than another
   amino-acid was sought for, but not found.},
