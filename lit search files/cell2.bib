@article{ WOS:A1957WU38700004,
Author = {HISADA, M},
Title = {MEMBRANE RESTING AND ACTION POTENTIALS FROM A PROTOZOAN,
   NOCTILUCA-SCINTILLANS},
Journal = {JOURNAL OF CELLULAR AND COMPARATIVE PHYSIOLOGY},
Year = {1957},
Volume = {50},
Number = {1},
Pages = {57-71},
Abstract = {Attempts were made to measure the resting and action potentials of a
   protozoan N. scintillans. Resting potential was measured
   potentiometrically with the micro-electrode of about 2u in tip diameter,
   action potential was recorded oscillographically using the
   microelectrode having a tip diameter of less than 0.5/i. Resting
   potential was obtained after the damage caused by impalement with the
   wide electrode was healed over. Average resting potential is 48mV
   negative to the medium outside at room temperature. And it was found
   that this depended greatly on the concentration of potassium in the
   outside medium. The action potential correlating to the spontaneous
   activity of the tentacle was found. The most striking property of this
   action potential is the increase, not the decrease, of the protoplasmic
   negativity. Average height of the action potential from zero level is 75
   mV, and it from the crest of preceding small depolarization is 40 mV.
   Effects of electrotonus and electrical stimulation were studied and no
   particular difference was found in excitable property in comparison with
   the muscle and nerve cells.},
